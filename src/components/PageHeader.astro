---
export interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<div class="page-header">
  <span class="page-eyebrow">{eyebrow}</span>
  <h1>{title}</h1>
  {subtitle && <p class="page-subtitle">{subtitle}</p>}
</div>

<style>
  .page-header {
    text-align: left;
    max-width: 640px;
    margin-bottom: 56px;
  }

  .page-eyebrow {
    display: inline-block;
    background: var(--color-overlay-medium);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .page-header h1 {
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 16px;
  }

  .page-subtitle {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .page-header {
      margin-bottom: 40px;
    }

    .page-header h1 {
      font-size: 2rem;
    }
  }
</style>
