---
// This is a pure Astro component that renders the particle background using vanilla JS
// No React dependency issues - works reliably
---

<div id="particle-container" class="particle-container"></div>

<style>
  .particle-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
  }

  .particle-container canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script is:inline>
(function() {
  // Wait for DOM to be ready
  function init() {
    const container = document.getElementById('particle-container');
    if (!container) return;

    // Create canvas
    const canvas = document.createElement('canvas');
    container.appendChild(canvas);
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Configuration based on theme
    function getConfig() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      
      if (isDark) {
        return {
          background: '#0d1526',
          particleColor: '#7b57eb',
          lineColor: '#6f57eb',
          particleCount: 60,
          particleSize: 2.5,
          lineWidth: 1,
          lineOpacity: 0.15,
          linkDistance: 180,
          speed: 0.5
        };
      } else {
        return {
          background: '#faf8f5',
          particleColor: '#9457eb',
          lineColor: '#8857eb',
          particleCount: 50,
          particleSize: 2.5,
          lineWidth: 1,
          lineOpacity: 0.25,
          linkDistance: 180,
          speed: 0.6
        };
      }
    }

    let config = getConfig();
    let particles = [];
    let animationId;
    let mouse = { x: null, y: null };

    // Resize canvas
    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    // Create particle
    function createParticle() {
      const angle = Math.random() * Math.PI * 2;
      const speed = config.speed * (0.5 + Math.random() * 0.5);
      return {
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        size: config.particleSize * (0.5 + Math.random() * 0.5)
      };
    }

    // Initialize particles
    function initParticles() {
      particles = [];
      for (let i = 0; i < config.particleCount; i++) {
        particles.push(createParticle());
      }
    }

    // Draw everything
    function draw() {
      // Clear with background color
      ctx.fillStyle = config.background;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Draw lines between particles
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < config.linkDistance) {
            const opacity = config.lineOpacity * (1 - dist / config.linkDistance);
            ctx.beginPath();
            ctx.strokeStyle = config.lineColor;
            ctx.globalAlpha = opacity;
            ctx.lineWidth = config.lineWidth;
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      // Draw lines to mouse (subtle)
      if (mouse.x !== null && mouse.y !== null) {
        for (let i = 0; i < particles.length; i++) {
          const dx = particles[i].x - mouse.x;
          const dy = particles[i].y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 150) {
            const opacity = config.lineOpacity * 1.5 * (1 - dist / 150);
            ctx.beginPath();
            ctx.strokeStyle = config.lineColor;
            ctx.globalAlpha = opacity;
            ctx.lineWidth = config.lineWidth;
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.stroke();
          }
        }
      }

      // Draw particles
      ctx.globalAlpha = 1;
      for (let i = 0; i < particles.length; i++) {
        ctx.beginPath();
        ctx.fillStyle = config.particleColor;
        ctx.arc(particles[i].x, particles[i].y, particles[i].size, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // Update particle positions
    function update() {
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;

        // Wrap around edges
        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width) p.x = 0;
        if (p.y < 0) p.y = canvas.height;
        if (p.y > canvas.height) p.y = 0;
      }
    }

    // Animation loop
    function animate() {
      update();
      draw();
      animationId = requestAnimationFrame(animate);
    }

    // Event listeners
    window.addEventListener('resize', function() {
      resize();
    });

    document.addEventListener('mousemove', function(e) {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    document.addEventListener('mouseleave', function() {
      mouse.x = null;
      mouse.y = null;
    });

    // Watch for theme changes
    const observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.attributeName === 'data-theme') {
          config = getConfig();
          initParticles();
        }
      });
    });
    observer.observe(document.documentElement, { attributes: true });

    // Start
    resize();
    initParticles();
    animate();
  }

  // Run on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
