---
import { ViewTransitions } from 'astro:transitions';
import '../styles/color.css';
import ParticleCanvas from '../components/ParticleCanvas.astro';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Abhyudaya Gupta - Personal Portfolio" } = Astro.props;

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/public/images/AG.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <ViewTransitions />
  </head>
  <body>
    <div class="theme-sweep" aria-hidden="true"></div>
    <ParticleCanvas />
    <nav class="navbar" id="main-navbar">
      <div class="nav-shell">
        <div class="nav-container">
          <div class="nav-left">
            <a href="/" class="nav-logo-img">
              <img src="/images/AG.svg" alt="AG Logo" class="logo" />
            </a>
            <a href="/" class="nav-logo">Abhyudaya Gupta</a>
          </div>
          <div class="nav-right">
            <div class="nav-menu">
              <a href="/" class="nav-link">Home</a>
              <a href="/about" class="nav-link">About</a>
              <a href="/projects" class="nav-link">Projects</a>
              <a href="/resume" class="nav-link">Resume</a>
            </div>
            <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
              <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
              <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    
    <footer class="footer">
      <div class="footer-content">
        <p>&copy; 2026 Abhyudaya Gupta. All rights reserved.</p>
        <div class="social-links">
          <a href="https://github.com/AbhyudayaGup" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/abhyudaya-gupta-6b7594378" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="mailto:abhyudaya.gupta.ag@gmail.com">Email</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      const themeToggle = document.getElementById('theme-toggle');
      const html = document.documentElement;
      const navbar = document.getElementById('main-navbar');
      const themeSweep = document.querySelector('.theme-sweep');
      let isScrolled = false;

      function applyTheme(theme) {
        html.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        if (themeToggle) {
          themeToggle.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
        }
      }

      function updateNavbarState() {
        if (!navbar) return;
        const next = window.scrollY > 12;
        if (next === isScrolled) return;
        isScrolled = next;
        navbar.classList.toggle('is-scrolled', next);
      }

      function runThemeSweep(theme, origin) {
        if (!themeSweep || !origin) return;
        const rect = origin.getBoundingClientRect();
        const x = rect.left + rect.width / 2;
        const y = rect.top + rect.height / 2;
        themeSweep.style.setProperty('--x', `${x}px`);
        themeSweep.style.setProperty('--y', `${y}px`);
        themeSweep.classList.remove('animate');
        void themeSweep.offsetWidth;
        themeSweep.setAttribute('data-theme', theme);
        themeSweep.classList.add('animate');
        window.setTimeout(() => themeSweep.classList.remove('animate'), 1700);
      }

      const storedTheme = localStorage.getItem('theme');
      const preferredTheme = storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      applyTheme(preferredTheme);
      updateNavbarState();

      window.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateNavbarState);
      }, { passive: true });

      document.addEventListener('astro:after-swap', () => {
        isScrolled = false;
        updateNavbarState();
      });

      document.addEventListener('click', (event) => {
        const btn = event.target.closest('#theme-toggle');
        if (!btn) return;
        const currentTheme = html.getAttribute('data-theme') || 'light';
        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(nextTheme);
        runThemeSweep(nextTheme, btn);
      });
    </script>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    background-color: var(--color-bg);
    scroll-behavior: smooth;
    transition: background-color 0.9s ease, color 0.9s ease;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    letter-spacing: -0.01em;
    color: var(--color-text);
    background: var(--color-bg);
    min-height: 100vh;
    position: relative;
    transition: color 0.9s ease, background-color 0.9s ease;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  @keyframes headerIn {
    0% {
      opacity: 0;
      transform: translateY(-18px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes popOut {
    0% {
      transform: translateY(28px) scale(0.9);
      opacity: 0;
    }
    55% {
      transform: translateY(-8px) scale(1.03);
      opacity: 1;
    }
    78% {
      transform: translateY(3px) scale(0.99);
    }
    100% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  @keyframes pageFade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @view-transition {
    navigation: auto;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.72s;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  ::view-transition-old(root) {
    animation-name: pageFadeOut;
  }

  ::view-transition-new(root) {
    animation-name: pageFadeIn;
  }

  @keyframes pageFadeOut {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-12px); }
  }

  @keyframes pageFadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  a, button {
    -webkit-tap-highlight-color: transparent;
  }

  .theme-sweep {
    position: fixed;
    inset: 0;
    z-index: 2000;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  .theme-sweep::before {
    content: '';
    position: absolute;
    left: var(--x, 50%);
    top: var(--y, 50%);
    width: 18px;
    height: 18px;
    transform: translate(-50%, -50%) scale(0.3);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, rgba(255,255,255,0.98), rgba(200,181,255,0.9) 18%, rgba(146,117,234,0.92) 38%, rgba(48,31,83,0.96) 100%);
    box-shadow: 0 0 0 10px rgba(164, 140, 255, 0.12), 0 0 80px rgba(126,92,232,0.24);
    transition: transform 1.8s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.2s ease;
  }

  .theme-sweep.animate {
    opacity: 1;
    visibility: visible;
  }

  .theme-sweep.animate::before {
    transform: translate(-50%, -50%) scale(58);
    opacity: 0.96;
  }

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0;
    pointer-events: none;
    transition: width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), top 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), left 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .nav-shell {
    width: 100%;
    pointer-events: auto;
    animation: headerIn 0.82s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 82px;
    width: 100%;
    padding: 0 26px 0 20px;
    background: var(--color-navbar-bg);
    border: 2px solid var(--color-navbar-edge);
    border-top: 0;
    border-bottom-width: 7px;
    border-radius: 0 0 30px 30px;
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    box-shadow: 0 18px 30px var(--color-navbar-shadow), inset 0 1px 0 rgba(255,255,255,0.34);
    transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.5s ease;
    position: relative;
  }

  .nav-container::before {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0;
    height: 1px;
    background: rgba(255,255,255,0.42);
    pointer-events: none;
  }

  .nav-container::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 12px;
    background: linear-gradient(180deg, var(--color-navbar-depth), rgba(0,0,0,0));
    border-radius: 0 0 30px 30px;
    pointer-events: none;
  }

  .nav-left,
  .nav-right,
  .nav-menu,
  .nav-link,
  .logo,
  .theme-toggle {
    position: relative;
    z-index: 1;
  }

  .navbar.is-scrolled {
    top: 16px;
    left: 50%;
    width: min(860px, calc(100% - 32px));
    transform: translateX(-50%);
  }

  .navbar.is-scrolled .nav-container {
    height: 62px;
    border-top-width: 2px;
    border-bottom-width: 5px;
    border-radius: 32px;
    background: var(--color-navbar-bg-solid);
    box-shadow: 0 22px 48px var(--color-navbar-shadow), inset 0 1px 0 rgba(255,255,255,0.42);
    animation: popOut 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .navbar.is-scrolled .nav-container::after {
    height: 10px;
    border-radius: 0 0 32px 32px;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-logo-img {
    display: flex;
    align-items: center;
  }

  .logo {
    width: 38px;
    height: 38px;
    transition: transform 0.2s ease;
    filter: drop-shadow(0 4px 10px rgba(126, 92, 232, 0.18));
  }

  .logo:hover {
    transform: scale(1.08);
  }

  .nav-logo {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-logo:hover {
    color: var(--color-accent);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 10px 12px;
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: -6px;
    left: 0;
    background: var(--color-accent);
    border-radius: 999px;
    transition: width 0.22s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .theme-toggle {
    background: rgba(255, 255, 255, 0.12);
    border: 1.5px solid rgba(129, 117, 156, 0.42);
    border-radius: 999px;
    width: 42px;
    height: 42px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: all 0.28s ease, transform 0.28s ease, box-shadow 0.28s ease;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.24), 0 8px 18px rgba(126,92,232,0.08);
  }

  .theme-toggle:hover {
    background: rgba(142, 122, 209, 0.12);
    color: var(--color-accent);
    transform: translateY(-1px) scale(1.03);
    border-color: rgba(129, 117, 156, 0.6);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), 0 12px 22px rgba(126,92,232,0.12);
  }

  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: block;
  }

  [data-theme="dark"] .sun-icon {
    display: block;
  }

  [data-theme="dark"] .moon-icon {
    display: none;
  }

  main {
    margin-top: 80px;
    min-height: calc(100vh - 152px);
  }

  .footer {
    background: rgba(255, 255, 255, 0.15);
    border-top: 1px solid var(--color-border);
    padding: 30px 0 40px;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .footer-content {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    letter-spacing: -0.01em;
  }

  .social-links {
    display: flex;
    gap: 24px;
  }

  .social-links a {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 0 12px;
    }

    .navbar.is-scrolled {
      top: 12px;
      width: min(860px, calc(100% - 24px));
    }

    .nav-container {
      height: 68px;
      padding: 0 16px;
    }

    .nav-logo {
      display: none;
    }

    .nav-menu {
      gap: 14px;
      padding: 8px 6px;
    }

    .nav-link {
      font-size: 0.7rem;
      letter-spacing: 0.01em;
    }

    .nav-right {
      gap: 12px;
    }

    .theme-toggle {
      width: 36px;
      height: 36px;
    }

    .footer-content {
      padding: 0 24px;
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
</style>
