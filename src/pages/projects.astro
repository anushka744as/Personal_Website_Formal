---
import Layout from '../layouts/Layout.astro';

const projects = [];
---

<Layout title="Projects - Abhyudaya Gupta">
  <div class="projects-container">
    <div class="back-button">
      <a href="/" class="back-link">← Back to Home</a>
    </div>
    
    <div class="projects-header">
      <h1>My Projects</h1>
      <p class="subtitle">A collection of my work and contributions to the tech community</p>
    </div>
    
    {projects.length === 0 && (
      <p class="empty-state">Projects coming soon.</p>
    )}

    {projects.some(p => p.featured) && (
    <div class="featured-projects">
      <h2>Featured Projects</h2>
      <div class="projects-grid featured">
        {projects.filter(p => p.featured).map(project => (
          <div class="project-card featured">
            <div class="project-image">
              <div class="image-placeholder">
                <span>{project.title.charAt(0)}</span>
              </div>
            </div>
            <div class="project-content">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="technologies">
                {project.technologies.map(tech => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
              <div class="project-links">
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="project-link live">
                  Live Demo
                </a>
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="project-link github">
                  View Code
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    )}

    {projects.length > 0 && (
    <div class="all-projects">
      <h2>All Projects</h2>
      <div class="projects-grid">
        {projects.map(project => (
          <div class="project-card">
            <div class="project-image">
              <div class="image-placeholder">
                <span>{project.title.charAt(0)}</span>
              </div>
            </div>
            <div class="project-content">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="technologies">
                {project.technologies.map(tech => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
              <div class="project-links">
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="project-link live">
                  Live Demo
                </a>
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="project-link github">
                  View Code
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    )}

    <div class="cta-section">
      <h2>Interested in Working Together?</h2>
      <p>I'm always open to discussing new opportunities and exciting projects.</p>
      <div class="cta-links">
        <a href="mailto:abhyudaya.gupta.ag@gmail.com" class="cta-link">Get In Touch</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .projects-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 64px 48px;
    position: relative;
  }

  .back-button {
    margin-bottom: 48px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .projects-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .projects-header h1 {
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .subtitle {
    font-size: 1.0625rem;
    color: var(--color-accent);
    letter-spacing: -0.01em;
    font-weight: 500;
  }

  .empty-state {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1rem;
    margin-bottom: 64px;
  }

  .featured-projects, .all-projects {
    margin-bottom: 64px;
  }

  .featured-projects h2, .all-projects h2 {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    margin-bottom: 24px;
  }

  .projects-grid {
    display: grid;
    gap: 24px;
  }

  .projects-grid.featured {
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  }

  .projects-grid:not(.featured) {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .project-card {
    background: var(--color-surface-strong);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.3s ease, border-color 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px var(--color-shadow);
    border-color: var(--color-accent);
  }

  .project-card.featured {
    border: 1px solid var(--color-border);
  }

  .project-image {
    height: 180px;
    background: var(--color-bg-hero);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .image-placeholder {
    width: 64px;
    height: 64px;
    background: var(--color-overlay-medium);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .project-content {
    padding: 24px;
  }

  .project-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .project-content p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .tech-tag {
    background: var(--color-overlay-medium);
    color: var(--color-accent);
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .project-links {
    display: flex;
    gap: 12px;
  }

  .project-link {
    padding: 8px 16px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
    transition: all 0.2s ease;
  }

  .project-link.live {
    background: var(--color-accent);
    color: #ffffff;
  }

  .project-link.live:hover {
    background: var(--color-accent-hover);
    opacity: 1;
  }

  .project-link.github {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .project-link.github:hover {
    background: var(--color-bg);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cta-section {
    text-align: center;
    background: var(--color-surface-strong);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 48px;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .cta-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .cta-section p {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }

  .cta-links {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cta-link {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: all 0.2s ease;
  }

  .cta-link:not(.secondary) {
    background: var(--color-accent);
    color: #ffffff;
  }

  .cta-link:not(.secondary):hover {
    background: var(--color-accent-hover);
  }

  .cta-link.secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .cta-link.secondary:hover {
    background: var(--color-overlay-light);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .projects-container {
      padding: 32px 24px;
    }

    .projects-header h1 {
      font-size: 1.875rem;
    }

    .projects-grid.featured,
    .projects-grid:not(.featured) {
      grid-template-columns: 1fr;
    }

    .project-links {
      flex-direction: column;
    }

    .cta-section {
      padding: 32px 24px;
    }

    .cta-links {
      flex-direction: column;
      align-items: center;
    }

    .cta-link {
      width: 180px;
      text-align: center;
    }
  }
</style>
