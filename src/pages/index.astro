---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Abhyudaya Gupta - Home">
  <div class="hero">
    <div class="hero-content">
      <h1 class="hero-title">Abhyudaya Gupta</h1>
      <p class="hero-subtitle">Student</p>
      
      <div class="circle-grid">
        <a href="/about" class="circle-item">
          <div class="circle">
            <span class="circle-text">About</span>
          </div>
        </a>
        
        <a href="/projects" class="circle-item">
          <div class="circle">
            <span class="circle-text">Projects</span>
          </div>
        </a>
        
        <a href="/research" class="circle-item">
          <div class="circle">
            <span class="circle-text">Research</span>
          </div>
        </a>

        <a href="/competitions" class="circle-item">
          <div class="circle">
            <span class="circle-text">Competitions</span>
          </div>
        </a>

      </div>
    </div>
  </div>
</Layout>

<style>
  html, body {
    overflow: hidden;
    height: 100vh;
  }

  :global(.footer) {
    display: none !important;
  }

  :global(main) {
    margin-top: 0 !important;
    min-height: 100vh !important;
  }

  .hero {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-text);
    text-align: center;
    padding: 0 48px;
    padding-top: 40px;
    transition: background-color 0.3s ease;
  }

  .hero-content {
    max-width: 720px;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
    line-height: 1.1;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-accent);
    margin-bottom: 32px;
  }

  .circle-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    max-width: 680px;
    margin: 0 auto;
  }

  .circle-item {
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .circle-item:hover {
    transform: translateY(-8px) scale(1.05);
  }

  .circle {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    margin: 0 auto;
    box-shadow: 0 4px 16px var(--color-shadow);
  }

  .circle:hover {
    background: var(--color-bg-secondary);
    border-color: var(--color-accent-3);
    box-shadow: 0 12px 32px var(--color-shadow);
  }

  .circle-text {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-align: center;
    color: var(--color-text);
    transition: color 0.3s ease;
  }

  .circle:hover .circle-text {
    color: var(--color-accent-3);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 0 24px;
      padding-top: 60px;
    }

    .hero-title {
      font-size: 2.25rem;
    }

    .hero-subtitle {
      font-size: 1rem;
      margin-bottom: 24px;
    }

    .circle-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .circle {
      width: 110px;
      height: 110px;
    }

    .circle-text {
      font-size: 0.875rem;
    }
  }
</style>
