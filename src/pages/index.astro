---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Abhyudaya Gupta - Home">
  <div class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-title">Abhyudaya Gupta</h1>
        <p class="hero-subtitle">
          A high school student passionate about <strong>STEM education</strong>,
          <strong>research</strong>, and <strong>tech leadership</strong>.
        </p>

        <p class="hero-bio">
          I built <strong>STEMXplore</strong>, a VR lab platform that's brought physics,
          chemistry, and CS experiments to 50+ schools and 25K+ students across India.
          I'm a published researcher working with Dr. Kuldeep Saha on graph-based modeling
          of fracture patterns using Topological Data Analysis, lead the ICT department
          for my school's Student Council running North India's #1 tech fest, and serve as
          Team Head for our Space Settlement Design Competition team.
        </p>

        <p class="hero-quote">"Building things that make STEM click for kids who never had a lab to try it in."</p>

        <div class="action-grid">
          <a href="/about" class="action-item">
            <span class="action-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21a8 8 0 0 0-16 0"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </span>
            <span class="action-label">About</span>
            <span class="action-meta">Profile</span>
          </a>

          <a href="/projects" class="action-item">
            <span class="action-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5v-9Z"></path>
                <path d="M8 9h8M8 13h6"></path>
              </svg>
            </span>
            <span class="action-label">Projects</span>
            <span class="action-meta">Selected work</span>
          </a>

          <a href="mailto:abhyudaya.gupta.ag@gmail.com" class="action-item">
            <span class="action-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m4 7 8 6 8-6"></path>
              </svg>
            </span>
            <span class="action-label">Contact</span>
            <span class="action-meta">Connect</span>
          </a>
        </div>
      </div>

      <div class="hero-photo">
        <div class="hero-photo-frame" id="hero-photo-frame">
          <img
            src="/images/profile.jpg"
            alt="Abhyudaya Gupta"
            class="hero-photo-img"
            onerror="this.style.display='none'; this.parentElement.classList.add('is-empty');"
          />
          <span class="hero-photo-placeholder" aria-hidden="true">AG</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  :global(html) {
    height: auto;
    min-height: 100%;
  }

  :global(body) {
    overflow-y: auto;
    height: auto;
    min-height: 100vh;
  }

  :global(.footer) {
    display: none !important;
  }

  :global(main) {
    margin-top: 0 !important;
    min-height: 100vh !important;
  }

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-text);
    text-align: left;
    padding: clamp(88px, 15vh, 116px) 24px clamp(24px, 4vh, 44px);
    transition: background-color 0.3s ease;
  }

  .hero-content {
    width: min(1180px, 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 64px;
    transform: translateY(0);
    animation: fadeUp 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero-text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero-photo {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
    animation: floatIn 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s both;
  }

  .hero-photo-frame {
    position: relative;
    width: clamp(160px, min(18vw, 32vh), 280px);
    aspect-ratio: 1 / 1;
    border-radius: 32px;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-elevated);
  }

  .hero-photo-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 32px;
    padding: 1px;
    background: linear-gradient(135deg, #8e7ad1, #5b8def, #e07a9c);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 1;
  }

  .hero-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-photo-placeholder {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-muted);
    background: linear-gradient(135deg, color-mix(in srgb, #8e7ad1 14%, transparent), color-mix(in srgb, #5b8def 10%, transparent));
  }

  .hero-photo-frame.is-empty .hero-photo-placeholder {
    display: flex;
  }

  .hero-title {
    font-size: clamp(2.9rem, 5.5vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.94;
    margin-bottom: 10px;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-text-muted);
    margin-bottom: clamp(10px, 2vh, 20px);
  }

  .hero-bio {
    max-width: 680px;
    margin: 0 0 clamp(12px, 2.2vh, 24px);
    font-size: clamp(0.9rem, 1.1vw, 1rem);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .hero-quote {
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    opacity: 0.85;
    margin-bottom: clamp(16px, 3.5vh, 40px);
  }

  .action-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vh, 26px);
    max-width: 700px;
    margin: 0;
  }

  .action-item {
    --card-accent: #8e7ad1;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    min-height: clamp(150px, 20vh, 228px);
    padding: clamp(16px, 2.5vh, 26px) 18px clamp(14px, 2vh, 24px);
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    transition: transform 0.34s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.34s ease, border-color 0.34s ease, background 0.34s ease;
    overflow: hidden;
    animation: floatIn 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .action-item:nth-child(2) { --card-accent: #5b8def; animation-delay: 0.12s; }
  .action-item:nth-child(3) { --card-accent: #e07a9c; animation-delay: 0.24s; }

  .action-item:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-elevated);
    border-color: color-mix(in srgb, var(--card-accent) 45%, transparent);
    background: var(--color-surface-strong);
  }

  .action-item::before {
    content: '';
    position: absolute;
    inset: 12px;
    border-radius: 22px;
    border: 1px solid rgba(255,255,255,0.18);
    pointer-events: none;
  }

  .action-item::after {
    content: '';
    position: absolute;
    left: 50%;
    top: -60px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, color-mix(in srgb, var(--card-accent) 26%, transparent), transparent 70%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.34s ease, top 0.4s ease;
  }

  .action-item:hover::after {
    opacity: 1;
    top: -40px;
  }

  .action-icon {
    position: relative;
    z-index: 1;
    width: clamp(56px, 9vh, 92px);
    height: clamp(56px, 9vh, 92px);
    margin-top: 6px;
    display: grid;
    place-items: center;
    border-radius: 30px;
    background: color-mix(in srgb, var(--card-accent) 11%, transparent);
    border: 1px solid color-mix(in srgb, var(--card-accent) 30%, transparent);
    color: var(--card-accent);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.22), 0 14px 26px color-mix(in srgb, var(--card-accent) 14%, transparent);
    transition: transform 0.28s ease, box-shadow 0.28s ease, background 0.28s ease;
  }

  .action-item:hover .action-icon {
    transform: translateY(-3px) scale(1.05);
    background: color-mix(in srgb, var(--card-accent) 16%, transparent);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.26), 0 16px 32px color-mix(in srgb, var(--card-accent) 22%, transparent);
    animation: wiggle 0.55s ease-in-out;
  }

  .action-icon svg {
    width: clamp(26px, 3.5vh, 40px);
    height: clamp(26px, 3.5vh, 40px);
    stroke-width: 1.7;
  }

  .action-label {
    position: relative;
    z-index: 1;
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: auto;
  }

  .action-meta {
    position: relative;
    z-index: 1;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-text-muted);
    margin-top: 12px;
  }

  @keyframes wiggle {
    0%, 100% { transform: rotate(0deg) scale(1); }
    25% { transform: rotate(-9deg) scale(1.08); }
    55% { transform: rotate(7deg) scale(1.05); }
    78% { transform: rotate(-3deg) scale(1.02); }
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes floatIn {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 768px) {
    :global(html),
    :global(body) {
      overflow-y: auto;
      height: auto;
      min-height: 100%;
    }

    .hero {
      height: auto;
      min-height: 100vh;
      padding: 104px 18px 40px;
    }

    .hero-content {
      flex-direction: column;
      gap: 28px;
      transform: translateY(-6px);
    }

    .hero-text {
      text-align: center;
    }

    .hero-photo-frame {
      width: clamp(140px, 40vw, 190px);
    }

    .action-grid {
      grid-template-columns: 1fr;
      gap: 18px;
      max-width: 400px;
      width: 100%;
      margin: 0 auto;
    }

    .action-item {
      min-height: 140px;
      border-radius: 26px;
      padding: 20px 16px;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
    }

    .action-icon {
      width: 64px;
      height: 64px;
      border-radius: 20px;
      margin-top: 0;
    }

    .action-icon svg {
      width: 28px;
      height: 28px;
    }

    .action-label {
      margin-top: 0;
      font-size: 1.05rem;
    }

    .action-meta {
      margin-top: 6px;
    }
  }
</style>
