---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Abhyudaya Gupta - Home">
  <div class="hero">
    <div class="hero-content">
      <h1 class="hero-title">Abhyudaya Gupta</h1>
      <p class="hero-subtitle">Student</p>
      
      <div class="circle-grid" style="grid-template-columns: repeat(2, 1fr); max-width: 380px;">
        <a href="/about" class="circle-item">
          <div class="circle">
            <span class="circle-text">About</span>
          </div>
        </a>
        
        <a href="/projects" class="circle-item">
          <div class="circle">
            <span class="circle-text">Projects</span>
          </div>
        </a>
        
        <a href="/research" class="circle-item">
          <div class="circle">
            <span class="circle-text">Research</span>
          </div>
        </a>

        <a href="/competitions" class="circle-item">
          <div class="circle">
            <span class="circle-text">Competitions</span>
          </div>
        </a>

      </div>
      
      <div class="hero-description">
        <p>Passionate about creating innovative digital experiences and solving complex problems through code.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .hero {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-text);
    text-align: center;
    padding: 80px 48px;
    transition: background-color 0.3s ease;
  }

  .hero-content {
    max-width: 720px;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
    line-height: 1.1;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-accent);
    margin-bottom: 48px;
  }

  .circle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 48px 0;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .circle-item {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .circle-item:hover {
    transform: translateY(-6px);
  }

  .circle {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    margin: 0 auto;
    box-shadow: 0 2px 8px var(--color-shadow);
  }

  .circle:hover {
    background: var(--color-bg-secondary);
    border-color: var(--color-accent);
    box-shadow: 0 8px 24px var(--color-shadow);
  }

  .circle-text {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-align: center;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .circle:hover .circle-text {
    color: var(--color-accent);
  }

  .hero-description {
    margin-top: 48px;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 60px 24px;
    }

    .hero-title {
      font-size: 2.25rem;
    }

    .hero-subtitle {
      font-size: 1.0625rem;
      margin-bottom: 32px;
    }

    .circle-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin: 32px 0;
    }

    .circle {
      width: 100px;
      height: 100px;
    }

    .circle-text {
      font-size: 0.8125rem;
    }

    .hero-description {
      margin-top: 32px;
      font-size: 0.9375rem;
    }
  }
</style>
