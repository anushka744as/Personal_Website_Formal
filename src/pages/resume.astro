---
import Layout from '../layouts/Layout.astro';

const skills = {
  "Programming Languages": ["JavaScript", "TypeScript", "Python", "Java", "SQL"],
  "Frontend Technologies": ["React", "Next.js", "Vue.js", "HTML5", "CSS3", "Tailwind CSS"],
  "Backend Technologies": ["Node.js", "Express.js", "Python Flask", "PostgreSQL", "MongoDB"],
  "Tools & Platforms": ["Git", "Docker", "AWS", "Firebase", "Figma", "Jira"]
};

const experience = [
  {
    title: "Senior Software Engineer",
    company: "Tech Company Inc.",
    location: "San Francisco, CA",
    duration: "2022 - Present",
    description: [
      "Lead development of scalable web applications using React, Node.js, and PostgreSQL",
      "Mentor junior developers and conduct code reviews to maintain code quality",
      "Collaborate with product managers and designers to implement new features",
      "Optimize application performance and implement best practices"
    ]
  },
  {
    title: "Full Stack Developer",
    company: "Startup XYZ",
    location: "New York, NY",
    duration: "2020 - 2022",
    description: [
      "Built and maintained multiple web applications from concept to deployment",
      "Implemented user authentication, payment processing, and real-time features",
      "Collaborated with cross-functional teams to deliver high-quality products",
      "Reduced application load time by 40% through optimization techniques"
    ]
  },
  {
    title: "Frontend Developer Intern",
    company: "Digital Agency ABC",
    location: "Los Angeles, CA",
    duration: "2019 - 2020",
    description: [
      "Developed responsive websites and web applications using modern technologies",
      "Worked with design teams to implement pixel-perfect user interfaces",
      "Participated in agile development processes and sprint planning",
      "Contributed to open-source projects and internal tool development"
    ]
  }
];

const education = [
  {
    degree: "Bachelor of Science in Computer Science",
    institution: "University of Technology",
    location: "San Francisco, CA",
    duration: "2016 - 2020",
    gpa: "3.8/4.0",
    highlights: [
      "Graduated with honors",
      "Relevant coursework: Data Structures, Algorithms, Software Engineering, Database Systems",
      "Capstone project: Machine Learning-powered recommendation system",
      "Dean's List recipient for 3 consecutive years"
    ]
  }
];

const certifications = [
  {
    name: "AWS Certified Developer Associate",
    issuer: "Amazon Web Services",
    date: "2023"
  },
  {
    name: "Google Cloud Professional Developer",
    issuer: "Google Cloud",
    date: "2022"
  },
  {
    name: "MongoDB Certified Developer",
    issuer: "MongoDB University",
    date: "2021"
  }
];
---

<Layout title="Resume - Nicol Rider">
  <div class="resume-container">
    <div class="back-button">
      <a href="/" class="back-link">← Back to Home</a>
    </div>
    
    <div class="resume-header">
      <div class="header-content">
        <h1>Nicol Rider</h1>
        <p class="title">Senior Software Engineer</p>
        <div class="contact-info">
          <span>📧 nicol@example.com</span>
          <span>📱 (555) 123-4567</span>
          <span>📍 San Francisco, CA</span>
        </div>
        <div class="social-links">
          <a href="https://linkedin.com/in/nicolrider" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com/nicolrider" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://nicolrider.com" target="_blank" rel="noopener noreferrer">Portfolio</a>
        </div>
      </div>
      
      <div class="download-section">
        <button class="download-btn" onclick="downloadResume()">
          📄 Download PDF
        </button>
      </div>
    </div>
    
    <div class="resume-content">
      <div class="section">
        <h2>Summary</h2>
        <p>
          Experienced software engineer with 4+ years of expertise in full-stack development, 
          specializing in modern web technologies. Proven track record of delivering scalable 
          applications and mentoring junior developers. Passionate about clean code, performance 
          optimization, and creating exceptional user experiences.
        </p>
      </div>
      
      <div class="section">
        <h2>Technical Skills</h2>
        <div class="skills-grid">
          {Object.entries(skills).map(([category, skillList]) => (
            <div class="skill-category">
              <h3>{category}</h3>
              <div class="skill-tags">
                {skillList.map(skill => (
                  <span class="skill-tag">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <div class="section">
        <h2>Professional Experience</h2>
        <div class="experience-list">
          {experience.map(job => (
            <div class="experience-item">
              <div class="experience-header">
                <div class="job-title">
                  <h3>{job.title}</h3>
                  <span class="company">{job.company}</span>
                </div>
                <div class="job-meta">
                  <span class="location">{job.location}</span>
                  <span class="duration">{job.duration}</span>
                </div>
              </div>
              <ul class="achievements">
                {job.description.map(achievement => (
                  <li>{achievement}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
      
      <div class="section">
        <h2>Education</h2>
        {education.map(edu => (
          <div class="education-item">
            <div class="education-header">
              <div class="degree-info">
                <h3>{edu.degree}</h3>
                <span class="institution">{edu.institution}</span>
              </div>
              <div class="education-meta">
                <span class="location">{edu.location}</span>
                <span class="duration">{edu.duration}</span>
                <span class="gpa">GPA: {edu.gpa}</span>
              </div>
            </div>
            <ul class="highlights">
              {edu.highlights.map(highlight => (
                <li>{highlight}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      
      <div class="section">
        <h2>Certifications</h2>
        <div class="certifications-grid">
          {certifications.map(cert => (
            <div class="certification-item">
              <h3>{cert.name}</h3>
              <p class="issuer">{cert.issuer}</p>
              <p class="date">{cert.date}</p>
            </div>
          ))}
        </div>
      </div>
      
      <div class="section">
        <h2>Projects</h2>
        <div class="projects-summary">
          <p>
            <strong>E-Commerce Platform:</strong> Full-stack application with React, Node.js, and PostgreSQL. 
            Features include user authentication, product management, and payment integration.
          </p>
          <p>
            <strong>Task Management App:</strong> Collaborative application with real-time updates using Next.js, 
            TypeScript, and Socket.io. Includes drag-and-drop functionality and team collaboration features.
          </p>
          <p>
            <strong>Weather Dashboard:</strong> Responsive weather application using Vue.js and multiple weather APIs. 
            Features include current conditions, forecasts, and interactive charts.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function downloadResume() {
    // Create a simple PDF download simulation
    const link = document.createElement('a');
    link.href = '/resume.pdf'; // You would need to add an actual PDF file
    link.download = 'Nicol_Rider_Resume.pdf';
    link.click();
    
    // For now, show an alert since we don't have an actual PDF
    alert('Resume download would start here. Please add a PDF file to the public folder.');
  }
</script>

<style>
  .resume-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 64px 48px;
    background: var(--color-bg);
    transition: background-color 0.3s ease;
  }

  .back-button {
    margin-bottom: 48px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .resume-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .header-content h1 {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 6px;
  }

  .title {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
  }

  .contact-info {
    display: flex;
    gap: 20px;
    margin-bottom: 12px;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .social-links {
    display: flex;
    gap: 16px;
  }

  .social-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--color-text);
  }

  .download-section {
    text-align: right;
  }

  .download-btn {
    background: var(--color-text);
    color: var(--color-bg);
    border: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .download-btn:hover {
    opacity: 0.8;
  }

  .resume-content {
    display: grid;
    gap: 40px;
  }

  .section {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 32px;
  }

  .section:last-child {
    border-bottom: none;
  }

  .section h2 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 20px;
  }

  .section p {
    line-height: 1.7;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
  }

  .skill-category h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-tag {
    background: var(--color-bg-secondary);
    color: var(--color-text);
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 0.8125rem;
    border: 1px solid var(--color-border);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .experience-list {
    display: grid;
    gap: 24px;
  }

  .experience-item {
    background: var(--color-bg-secondary);
    padding: 24px;
    border-radius: 8px;
    border-left: 3px solid var(--color-text-muted);
    transition: background-color 0.3s ease;
  }

  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
  }

  .job-title h3 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .company {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .job-meta {
    text-align: right;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .location, .duration {
    display: block;
    margin-bottom: 4px;
  }

  .achievements {
    list-style: none;
    padding: 0;
  }

  .achievements li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 8px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .achievements li::before {
    content: "•";
    color: var(--color-text-muted);
    position: absolute;
    left: 0;
  }

  .education-item {
    background: var(--color-bg-secondary);
    padding: 24px;
    border-radius: 8px;
    transition: background-color 0.3s ease;
  }

  .education-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
  }

  .degree-info h3 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .institution {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .education-meta {
    text-align: right;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .education-meta span {
    display: block;
    margin-bottom: 4px;
  }

  .highlights {
    list-style: none;
    padding: 0;
  }

  .highlights li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 8px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .highlights li::before {
    content: "•";
    color: var(--color-text-muted);
    position: absolute;
    left: 0;
  }

  .certifications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .certification-item {
    background: var(--color-bg-secondary);
    padding: 24px;
    border-radius: 8px;
    text-align: center;
    transition: background-color 0.3s ease;
  }

  .certification-item h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .issuer {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .projects-summary p {
    margin-bottom: 16px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .projects-summary strong {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .resume-container {
      padding: 32px 24px;
    }

    .resume-header {
      flex-direction: column;
      gap: 24px;
    }

    .header-content h1 {
      font-size: 1.75rem;
    }

    .contact-info {
      flex-direction: column;
      gap: 8px;
    }

    .experience-header,
    .education-header {
      flex-direction: column;
      gap: 12px;
    }

    .job-meta,
    .education-meta {
      text-align: left;
    }

    .skills-grid,
    .certifications-grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .back-button,
    .download-section {
      display: none;
    }

    .resume-container {
      padding: 0;
    }

    .section {
      break-inside: avoid;
    }
  }
</style>
