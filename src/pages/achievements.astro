---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const stats = [
  { value: "1500", label: "SAT Superscore" },
  { value: "39/42", label: "IB Semester 2 Score" },
  { value: "2", label: "AP Exams Scored 5/5" },
  { value: "95.5", label: "Top IGCSE Board Score" },
];

const scores = [
  {
    icon: "🎯",
    name: "SAT",
    score: "1500",
    max: "1600",
    description: "SAT Superscore (Math 780 · English 720)",
    date: "August 2026",
    badge: "Superscore",
    highlight: true,
  },
  {
    icon: "📊",
    name: "AP Microeconomics",
    score: "5",
    max: "5",
    description: "Advanced Placement Economics",
    date: "May 2025",
  },
  {
    icon: "💻",
    name: "AP Computer Science A",
    score: "5",
    max: "5",
    description: "Advanced Placement Computer Science",
    date: "May 2024",
  },
  {
    icon: "📐",
    name: "AP Calculus BC",
    score: "4",
    max: "5",
    description: "Advanced Placement Mathematics",
    date: "May 2024",
  },
  {
    icon: "⚛️",
    name: "AP Physics 1: Algebra-Based",
    score: "4",
    max: "5",
    description: "Advanced Placement Physics",
    date: "May 2024",
  },
  {
    icon: "🌍",
    name: "IGCSE Mathematics International",
    score: "95.5",
    max: "100",
    description: "Grade 10 Board Examination · A*",
    date: "2024",
  },
  {
    icon: "🧪",
    name: "IGCSE Physics",
    score: "85.5",
    max: "100",
    description: "Grade 10 Board Examination · A*",
    date: "2024",
  },
  {
    icon: "📘",
    name: "IB HL Physics",
    score: "7",
    max: "7",
    description: "Grade 11 Semester 2 (Predicted)",
    date: "2026",
  },
  {
    icon: "🎓",
    name: "IB Semester 2 Total",
    score: "39",
    max: "42",
    description: "IB Diploma Programme · Grade 11",
    date: "2026",
    //badge: "Personal Best",
    highlight: true,
  },
];
---

<Layout title="Achievements - Abhyudaya Gupta">
  <div class="achievements-page">
    <PageHeader
      eyebrow="Academics"
      title="Academic Achievements"
      subtitle="A record of excellence in standardized testing and coursework."
    />

    <div class="achievements-content">
      <div class="stats-grid">
        {stats.map(stat => (
          <div class="stat-tile">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>

      <div class="scores-grid">
        {scores.map((item, i) => (
          <div class:list={["score-card", { highlight: item.highlight }]}>
            <div class="score-icon">{item.icon}</div>
            <h3 class="score-name">{item.name}</h3>
            <div class="score-value">
              <span class="score-number">{item.score}</span>
              <span class="score-sep">/</span>
              <span class="score-max">{item.max}</span>
            </div>
            <p class="score-description">{item.description}</p>
            <p class="score-date">{item.date}</p>
            {item.badge && <span class="score-badge">⭐ {item.badge}</span>}
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .achievements-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 64px 48px;
    position: relative;
  }

  .achievements-content {
    position: relative;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 56px;
  }

  .stat-tile {
    background: var(--color-surface-strong);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 28px 20px;
    text-align: center;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .scores-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .score-card {
    background: var(--color-surface-strong);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 28px;
    text-align: center;
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
  }

  .score-card:hover {
    transform: translateY(-2px);
  }

  .score-card.highlight {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .score-icon {
    font-size: 2rem;
    margin-bottom: 12px;
  }

  .score-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 14px;
    min-height: 24px;
  }

  .score-value {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .score-number {
    color: var(--color-accent);
  }

  .score-sep {
    color: var(--color-text-muted);
    margin: 0 2px;
  }

  .score-max {
    color: var(--color-text-muted);
  }

  .score-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .score-date {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .score-badge {
    display: inline-block;
    background: var(--color-overlay-medium);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 8px;
  }

  @media (max-width: 900px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .scores-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .achievements-page {
      padding: 32px 24px;
    }

    .stats-grid,
    .scores-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
